# Public switch for the Owner access button. Authentication remains server-side.
VITE_ENABLE_OWNER_STUDIO=true

# Development-only fallback used by plain `npm run dev`, where Vercel API
# functions are not running. Never use this as the production owner password.
VITE_OWNER_PASSCODE=change-this-local-owner-passcode

# Production-only secret. Add it in Vercel, never to a VITE_ variable.
# Use at least 16 characters; a long randomly generated value is recommended.
OWNER_ADMIN_KEY=replace-with-a-long-private-owner-password

# Server-only Upstash REST credentials. You may copy the corresponding values
# created by the Vercel/Upstash integration into these custom variable names.
STORAGE_URL=
STORAGE_TOKEN=

# These integration-provided names remain supported as automatic fallbacks:
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
